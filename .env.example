# Copy this file to `.env` and fill in your key.
# Get a FREE Groq API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional — override the model (default: openai/gpt-oss-120b, best tool-calling here).
# Lighter/faster option: GROQ_MODEL=openai/gpt-oss-20b

# Note: embeddings are LOCAL (fastembed) — no embedding key needed.
